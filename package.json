{
  "name": "luxio-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-with-timer.mjs",
    "build:agent": "pnpm --filter @julyware/clover-agent build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm changeset version && pnpm -r publish --filter @julyware/clover-agent --filter @julyware/clover-ui --filter @julyware/clover"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0"
  }
}
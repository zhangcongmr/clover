{
  "name": "clover-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-with-timer.mjs",
    "build:agent": "pnpm --filter @julyware/clover-agent build",
    "build:mcp:restaurant": "pnpm --filter @clover/mcp-restaurant build",
    "mcp:restaurant": "node packages/mcp-restaurant/dist/index.cjs",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/guard-publish.mjs && node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0"
  }
}
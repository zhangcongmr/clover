{
  "name": "clover-monorepo",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "build": "node scripts/build-with-timer.mjs",
    "build:server": "pnpm --filter @julyware/clover-server build",
    "build:clover": "cargo build --release -p clover-server --features web-ui",
    "build:web": "pnpm --filter @julyware/clover-ui run build:web",
    "stage:web": "node packages/server-rust/scripts/stage-web.mjs",
    "build:cli:npm": "pnpm run build:web && node packages/server-rust/scripts/build-npm.mjs",
    "publish:cli": "node packages/server-rust/scripts/publish-npm.mjs",
    "parity": "node scripts/parity.mjs",
    "build:mcp:restaurant": "pnpm --filter @clover/mcp-restaurant build",
    "build:mcp:rag": "pnpm --filter @clover/mcp-rag build",
    "mcp:restaurant": "node packages/mcp-restaurant/dist/index.cjs",
    "mcp:rag": "node packages/mcp-rag/dist/index.cjs",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-cargo-version.mjs",
    "release": "node scripts/guard-publish.mjs && node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0"
  }
}
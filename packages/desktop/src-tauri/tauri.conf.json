{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clover",
  "version": "../package.json",
  "identifier": "Clover",
  "build": {
    "beforeDevCommand": "pnpm --filter @julyware/clover-ui run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm --filter @julyware/clover-ui run build:web",
    "frontendDist": "../../assistant/dist/clover/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Clover",
        "center": true,
        "maximized": true,
		"decorations": false,
		"devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

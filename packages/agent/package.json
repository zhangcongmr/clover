{
  "name": "@luxio/agent",
  "version": "0.1.0",
  "description": "Local proxy agent for Luxio Web App - provides file system access and PTY terminal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.18.0",
    "uuid": "^14.0.0",
    "@a2a-js/sdk": "^0.3.13",
    "@agentclientprotocol/sdk": "^1.2.1",
    "node-pty": "^1.2.0-beta.14",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "@types/ws": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}

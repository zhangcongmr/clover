{
  "name": "@julyware/clover-agent",
  "version": "0.1.1",
  "description": "Local proxy agent for Clover - provides file system access, PTY terminal, and ACP server",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs && pnpm run build"
  },
  "keywords": [
    "clover",
    "agent",
    "acp",
    "pty",
    "proxy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangcongmr/clover.git"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.18.0",
    "uuid": "^14.0.0",
    "@a2a-js/sdk": "^0.3.13",
    "@agentclientprotocol/sdk": "^1.2.1",
    "node-pty": "^1.2.0-beta.14",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "@types/ws": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}

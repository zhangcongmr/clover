{
  "name": "@julyware/common",
  "version": "0.1.0",
  "description": "A minimal, pure TypeScript library ready to be published as an npm package.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"No tests configured yet.\" && exit 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typescript",
    "library",
    "npm"
  ],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
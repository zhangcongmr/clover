    "@tailwindcss/vite": "4.1.12",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "tsup": "^8.5.1",
    "vite": "6.3.5",
    "vite-plugin-mkcert": "^1.17.9"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {

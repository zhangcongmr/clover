{
  "name": "luxio",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/luxio-common/index.js",
      "require": "./dist/luxio-common/index.cjs"
    }
  },
  "types": "./dist/luxio-common/index.d.ts",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0",
    "build:app": "ng build",
    "build:common": "ng build --configuration=common && node scripts/inline-styles.mjs && tsc -p tsconfig.declaration.json",
    "build": "pnpm run build:common && pnpm run build:app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:luxio": "node dist/luxio/server/server.mjs"
  },
  "public": true,
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",

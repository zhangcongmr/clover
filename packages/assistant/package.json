    "@angular/compiler-cli": "^21.2.4",
    "@types/chrome": "~0.0.332",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.15",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.19.33",
    "buffer": "^5.7.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",

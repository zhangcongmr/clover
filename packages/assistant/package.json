{
  "name": "luxio",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/luxio-common/index.js",
      "require": "./dist/luxio-common/index.cjs"
    }
  },
  "types": "./dist/luxio-common/index.d.ts",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0 --ssl",
    "build:app": "ng build",
    "build:common": "node scripts/inline-styles.mjs && ng build --configuration=common && tsc -p tsconfig.declaration.json",
    "build": "pnpm run build:common && pnpm run build:app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:luxio": "node dist/luxio/server/server.mjs"
  },
  "public": true,
  "dependencies": {
    "@angular/animations": "^20.3.16",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/forms": "^20.3.16",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/platform-server": "^20.3.16",
    "@angular/router": "^20.3.16",
    "@angular/ssr": "^20.3.16",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lang-css": "^6.0.2",
    "@codemirror/lang-html": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "^6.0.2",
    "@codemirror/view": "^6.39.13",
    "@luxio/community-widget": "workspace:*",
    "@mlc-ai/web-llm": "^0.2.80",
    "@tailwindcss/postcss": "^4.1.18",
    "api-render-ui": "^1.1.0",
    "asn1js": "^3.0.7",
    "codemirror": "^6.0.2",
    "express": "^5.2.1",
    "marked": "^14.1.4",
    "opfs-tools": "^0.6.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.16",
    "@angular/cli": "^20.3.16",
    "@angular/compiler-cli": "^20.3.16",
    "@types/chrome": "~0.0.332",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^20.19.33",
    "buffer": "^5.7.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "typescript": "~5.9.3"
  }
}

{
  "name": "@julyware/clover-ui",
  "version": "0.1.2",
  "description": "Clover embeddable UI library (Clover component) built with Angular",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/clover-common/index.js",
      "require": "./dist/clover-common/index.cjs"
    }
  },
  "types": "./dist/clover-common/index.d.ts",
  "files": [
    "dist/clover-common"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0 --ssl",
    "build:app": "ng build",
    "build:common": "ng build --configuration=common && node scripts/inline-styles.mjs && tsc -p tsconfig.declaration.json",
    "build": "pnpm run build:common && pnpm run build:app && node scripts/copy-node-pty.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:clover": "node dist/clover/server/server.mjs",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs && pnpm run build:common"
  },
  "keywords": [
    "clover",
    "clover",
    "angular",
    "editor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangcongmr/clover.git"
  },
  "dependencies": {
    "@a2ui/angular": "^0.10.1",
    "@a2ui/markdown-it": "^0.0.4",
    "@a2ui/web_core": "^0.10.2",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@angular/animations": "^21.2.4",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/platform-server": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@angular/ssr": "^21.2.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.0.2",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.0.2",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "^6.0.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.1",
    "@codemirror/view": "^6.39.13",
    "@mlc-ai/web-llm": "^0.2.80",
    "@tailwindcss/postcss": "^4.1.18",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.1.0-beta.195",
    "api-render-ui": "^1.2.4",
    "asn1js": "^3.0.7",
    "codemirror": "^6.0.2",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "marked": "^14.1.4",
    "opfs-tools": "^0.6.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@julyware/clover-agent": "workspace:*",
    "@julyware/common": "workspace:*",
    "@julyware/community-widget": "workspace:*",
    "@types/chrome": "~0.0.332",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.19.33",
    "@types/ws": "^8.18.0",
    "buffer": "^5.7.1",
    "jsdom": "^29.1.1",
    "node-pty": "^1.2.0-beta.14",
    "postcss": "^8.5.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
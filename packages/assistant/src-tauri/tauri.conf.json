{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clover-assistant",
  "version": "0.1.0",
  "identifier": "com.julyware.clover-assistant",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "https://localhost:4200",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/clover/browser"
  },
  "app": {
    "windows": [
      {
        "title": "clover-assistant",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
